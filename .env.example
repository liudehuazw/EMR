# ================================================
# docker compose 环境变量示例
# 用法：复制本文件为 .env（同目录），按需填写后执行 docker compose up -d
#   .env 已被 .gitignore 忽略，请勿把真实密钥提交到代码库
# 默认本地存储：不填 OSS 也可上传文件；OCR 需 docker compose --profile ocr；AI 需在系统设置中配置
# ================================================

# ---- 存储（默认 local，无需云服务）----
FILE_STORAGE_TYPE=local

# ---- 数据库（compose 内部使用，按需修改）----
MYSQL_ROOT_PASSWORD=emr_root_2024
MYSQL_USER=emr
MYSQL_PASSWORD=emr_password_2024

# ---- Redis ----
REDIS_PASSWORD=emr_redis_2024

# ---- JWT 签名密钥（HS256 要求 ≥ 32 字节，生产环境务必改掉）----
JWT_SECRET=emr-docker-dev-secret-change-me-at-least-32-bytes

# ---- DeepSeek / 大模型 API（AI 报告分析 + AI 就诊助手，可选）----
DEEPSEEK_API_KEY=

# ---- 阿里云 OSS（可选：系统设置切到 OSS 时需填写）----
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET_NAME=
